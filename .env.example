# Copie para `.env` e ajuste se precisar. O `.env` nunca vai para o git.

# Pasta dos dados (banco, backups, logs). Padrão: ./data
# MYEDINHOS_DATA_DIR=data

# Porta do servidor local (sempre em 127.0.0.1). Padrão: 8000
# MYEDINHOS_PORTA=8000

# Nível de log: DEBUG, INFO, WARNING, ERROR. Padrão: INFO
# MYEDINHOS_NIVEL_LOG=INFO

# Token gratuito da brapi.dev (cotações e proventos da B3). Sem ele, usa o Yahoo.
# BRAPI_TOKEN=
